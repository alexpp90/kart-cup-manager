{
  "name": "kart-cup-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.server.config.ts",
    "preview": "vite preview",
    "serve": "vite build && vite preview --host --port 4173",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "e2e": "npm run build && playwright test",
    "screenshots": "node e2e/readme-shots.mjs",
    "trace:check": "node scripts/trace-check.mjs",
    "host": "npm run build && node dist/server.mjs",
    "package:server": "npm run build && node scripts/package-pi.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
