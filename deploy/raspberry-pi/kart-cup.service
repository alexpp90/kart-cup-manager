[Unit]
Description=Kart Cup server (app + phone sign-up)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
EnvironmentFile=/etc/kart-cup/env
ExecStart=/usr/bin/env node /opt/kart-cup/server.mjs
Restart=always
RestartSec=2
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Hardening: the server only needs its data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kart-cup
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
